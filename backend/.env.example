OPENAI_API_KEY=sk-your-openai-api-key-here

# Prefer Tavily; SerpAPI is alternative. Without both, DuckDuckGo site:uamd.edu.al is used.
TAVILY_API_KEY=tvly-your-tavily-api-key-here
SERPAPI_API_KEY=your-serpapi-key-here

FLASK_PORT=5001
FLASK_DEBUG=true
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_RELEVANCE_SCORE=0.22
QUERY_CACHE_TTL=120
PAGE_CACHE_TTL=180
USE_CURATED_CATALOG=0
CHROMA_PATH=./chroma_db
CACHE_FOLDER=./cache
OPENAI_MODEL=gpt-4o-mini
